# Beispielkonfiguration für den Wiki.js MCP Server (v0.7.0).
# Kopieren nach .env und Werte anpassen. Siehe README.md.

# --- Wiki.js ---------------------------------------------------------------
# Basis-URL, unter der DIESER SERVER die Wiki.js-GraphQL-API erreicht
# (ohne /graphql). In Docker ist das oft der interne Servicename.
WIKIJS_BASE_URL=https://wiki.example.com

# Öffentliche URL, unter der BENUTZER das Wiki im Browser öffnen. Wird nur für
# die "url"-Felder der zurückgegebenen Seiten verwendet, damit die vom Agent
# zitierten Links anklickbar sind. Nötig, wenn WIKIJS_BASE_URL eine interne
# Adresse ist, z. B.:
#   WIKIJS_BASE_URL=http://wiki:3000
#   WIKIJS_URL=https://wiki.hacktober.ch
# Leer = identisch mit WIKIJS_BASE_URL (Default).
WIKIJS_URL=

# API-Key aus Wiki.js: Administration → API Access → API aktivieren → Key erzeugen
WIKIJS_API_KEY=your-api-key

# Standard-Locale für Seiten (nur relevant bei mehrsprachigen Wikis)
WIKIJS_DEFAULT_LOCALE=en

# true = nur Lese-Tools (list/get/search), keine create/update/delete-Tools
WIKIJS_READ_ONLY=false

# Optional: harte Bereichsgrenze. Ist sie gesetzt, arbeiten ALLE Page-Tools nur
# noch innerhalb dieses Pfads — gelistet, gesucht, gelesen, angelegt,
# geändert und gelöscht werden ausschließlich Seiten unter diesem Präfix.
# Beispiel: WIKIJS_PATH_PREFIX=CTF2026 erlaubt "ctf2026" und "ctf2026/...",
# aber nicht "ctf2025/...", "ctf20260/..." oder "ctf2026-old".
# Führende/abschließende Slashes und ein Locale-Präfix werden entfernt.
# Leer = keine Einschränkung (Default).
WIKIJS_PATH_PREFIX=

# --- MCP-Server ------------------------------------------------------------
# http (für Mattermost, Default) oder stdio (für lokale MCP-Clients)
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3123

# Empfohlen: Token zum Schutz des HTTP-Endpunkts. In Mattermost als Custom
# Header "Authorization: Bearer <token>" hinterlegen. Leer = kein Auth-Check.
MCP_AUTH_TOKEN=

# Optional: Name des MCP-Servers (wird Clients angezeigt)
MCP_SERVER_NAME=wikijs-mcp-server
