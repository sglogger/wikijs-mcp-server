# --- Wiki.js ---------------------------------------------------------------
# Basis-URL der Wiki.js-Instanz (ohne /graphql)
WIKIJS_BASE_URL=https://wiki.example.com

# API-Key aus Wiki.js: Administration → API Access → API aktivieren → Key erzeugen
WIKIJS_API_KEY=your-api-key

# Standard-Locale für Seiten (nur relevant bei mehrsprachigen Wikis)
WIKIJS_DEFAULT_LOCALE=en

# true = nur Lese-Tools (list/get/search), keine create/update/delete-Tools
WIKIJS_READ_ONLY=false

# --- MCP-Server ------------------------------------------------------------
# http (für Mattermost, Default) oder stdio (für lokale MCP-Clients)
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3123

# Empfohlen: Token zum Schutz des HTTP-Endpunkts. In Mattermost als Custom
# Header "Authorization: Bearer <token>" hinterlegen. Leer = kein Auth-Check.
MCP_AUTH_TOKEN=

# Optional: Name des MCP-Servers (wird Clients angezeigt)
MCP_SERVER_NAME=wikijs-mcp-server
